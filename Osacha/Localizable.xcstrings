    },
    "Welcome to Osacha": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Osachaへようこそ"
          }
        }
      }
    },
    "Welcome to Osacha!": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Osachaへようこそ！"
          }
        }
      }
    },
    "Welcome to Osacha, %@! Your loyalty card is ready — every order earns a stamp.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@さん、Osachaへようこそ！ポイントカードの準備ができました。ご注文ごとにスタンプが貯まります。"
          }
        }
      }
    },
    "Well packed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "梱包が丁寧"
          }
        }
      }
    },
    "What is the refund policy?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返金ポリシーを教えてください。"
          }
        }
      }
    },
    "Where do you deliver?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配達エリアはどこですか？"
          }
        }
      }
    },
    "Where vibrant matcha meets the gentle bloom of rose in a velvety latte.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鮮やかな抹茶とやさしいローズが出会う、なめらかなラテ。"
          }
        }
      }
    },
    "Where vibrant matcha meets the gentle bloom of rose, this smooth and creamy latte blends the subtle sweetness of rose with earthy depth, creating a velvety sip that's both refreshing and serene.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鮮やかな抹茶にやさしく香るローズを合わせた、なめらかでクリーミーなラテ。ほのかなローズの甘さと抹茶の深みが溶け合う、爽やかで穏やかな一杯です。"
          }
        }
      }
    },
    "With Ice Cream": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイスクリーム追加"
          }
        }
      }
    },
